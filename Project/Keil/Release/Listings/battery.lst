   7          /**
   8           * @brief 将ad值转换为对应的电压值
   9           *
  10           * @param arg_adc_val 采集到的ad值
  11           * @return u8 计算好的电压值，单位0.1V
  12           */
  13          u16 conver_adc_val_to_voltage(u16 arg_adc_val)
  14          {
  15   1          /*
  16   1              采集到的ad值范围：0~4095
  17   1              ad值对应的电压： 0 ~ MAX_VOLTAGE_OF_BATTERY
  18   1              那么 每单位ad值对应 MAX_VOLTAGE_OF_BATTERY / 4096
  19   1          */
  20   1          // return (u32)arg_adc_val * MAX_VOLTAGE_OF_BATTERY / 4096;
  21   1      
  22   1          // 使用2.4V参考电压，12位精度
  23   1          // 电池电压是 1/11 分压：
  24   1          return (u32)arg_adc_val * 240 * 11 / 10 / 4096;
  25   1      }
  26          
  27          // 将电池电压转换为对应的百分比
  28          // voltage： 0~255 ， 对应0~25.5V
  29          // 例如 voltage == 140，对应14.0V
  30          u8 conver_voltage_of_battery_to_percentage(u8 voltage)
  31          {
  32   1          u8 tmp;
  33   1      
  34   1          // 客户要求，如果检测到大于15V，就认为满电
  35   1          if (voltage >= 150)
  36   1          {
  37   2              tmp = 100;
  38   2          }
  39   1          else
  40   1          {
  41   2              // 如果电压小于15V，根据公式来得到百分比
  42   2              // 用电池电压voltage除以MAX_VOLTAGE_OF_BATTERY，得到占比，再乘以100，得到百分
             -比
  43   2              tmp = (u16)voltage * 100 / MAX_VOLTAGE_OF_BATTERY;
  44   2          }
  45   1      
  46   1          return tmp;
  47   1      }
